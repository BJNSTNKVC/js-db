{
  "name": "@bjnstnkvc/db",
  "version": "2.0.0",
  "description": "TypeScript database layer for IndexedDB with an API modeled on Laravel.",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/main.d.ts", "default": "./dist/main.js" },
      "require": { "types": "./dist/main.d.cts", "default": "./dist/main.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/main.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BJNSTNKVC/js-db.git"
  },
  "keywords": [
    "ts",
    "typescript",
    "laravel",
    "database",
    "indexeddb",
    "migrations",
    "query-builder"
  ],
  "author": "Bojan Stankovic <dev.bojan.stankovic@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BJNSTNKVC/js-db/issues"
  },
  "homepage": "https://github.com/BJNSTNKVC/js-db#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
